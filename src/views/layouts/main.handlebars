<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Header / Navigation Bar -->
  <header class="app-header">
    <div class="container header-container">
      <div class="brand">
        <div class="logo-icon">☁️</div>
        <div>
          <h1 class="brand-title">CloudBook Manager</h1>
          <p class="brand-subtitle">Hạ tầng Đám Mây & Kiến trúc Phân tán</p>
        </div>
      </div>
      
      <div class="header-badges">
        <span class="badge badge-success">● Least Privilege (Dual Connection)</span>
        <span class="badge badge-info">● Stateless Session (MongoDB Cloud)</span>
        <span class="badge badge-primary">MSSV: {{studentId}}</span>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content">
    {{{body}}}
  </main>

  <!-- Mandatory Footer as requested by exam requirement -->
  <footer class="app-footer">
    <div class="container footer-content">
      <div class="footer-info">
        <p class="footer-primary">
          <strong>Họ và tên:</strong> {{studentName}} &nbsp;|&nbsp; 
          <strong>MSSV:</strong> {{studentId}} &nbsp;|&nbsp; 
          <strong>Mức thuế VAT áp dụng:</strong> <span class="vat-highlight">{{vatRate}}%</span>
        </p>
        <p class="footer-secondary">
          Bài Kiểm Tra Giữa Kì - Môn Điện toán đám mây &copy; 2026. Thiết kế và triển khai trên hạ tầng PaaS Cloud.
        </p>
      </div>
      <div class="footer-status">
        <span class="status-indicator"></span> Cloud Online 24/7
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
